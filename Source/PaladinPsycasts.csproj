<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PaladinPsycasts</AssemblyName>
    <RootNamespace>PaladinPsycasts</RootNamespace>
    <Version>1.0.0</Version>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- Where the game and its frameworks live. Override on the command line with
       /p:RimWorldDir=... /p:WorkshopDir=... if this machine's paths ever change. -->
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">E:\SteamLibrary\steamapps\workshop\content\294100</WorkshopDir>
    <ManagedDir>$(RimWorldDir)</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(ManagedDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Graphics.DrawMesh has overloads taking engine types, so the compiler needs the engine assembly to pick one. -->
    <Reference Include="Waylith">
      <HintPath>$(ManagedDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VEF">
      <HintPath>$(WorkshopDir)\2023507013\1.7\Assemblies\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VanillaPsycastsExpanded">
      <HintPath>$(WorkshopDir)\2842502659\1.6\Assemblies\VanillaPsycastsExpanded.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
